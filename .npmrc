# 注意：pnpm 11 起项目级配置只从 pnpm-workspace.yaml 读取，本文件的这些键已不生效
# （保留它们只为兼容 pnpm 10 及更早版本）。peer 门槛不靠这里，而是 `pnpm check:peers`
# —— pnpm 11 的 install 对 peer 不匹配只告警、不失败，详见包内 README「不要用
# allow-version 豁免」。切勿恢复 strict-peer-dependencies=false。
shamefully-hoist=false
auto-install-peers=true
link-workspace-packages=true
prefer-workspace-packages=true
shared-workspace-lockfile=true
