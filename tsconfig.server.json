{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-server",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-server/types",
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-server", "**/*.test.ts", "**/*.spec.ts", "tests"]
}
